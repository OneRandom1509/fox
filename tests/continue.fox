let i = 1;

while(i<10) {
  if(i == 5){
    i = i+1;
    continue;
  }
  print i;
  i = i+1;
}

for(let j = 1; j<10; j = j+1) {
  if(j == 5) {
    j = j+1;
    continue;
  }
  print j;
}

let a = 0;
while(a<4) {
  let b = 0;
  while(b<4) {
    if(b == 2) {
      b = b+1;
      continue;
    }
    print "b is " + b;
    b = b+1;
  }
  if(a == 2) {
    a = a+1;
    continue;
  }
  print "a is " + a;
  a = a+1;
}
