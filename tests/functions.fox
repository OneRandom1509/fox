fun say_hello() {
  print "Hello there!";
}

say_hello();

fun fib(n) {
  if(n <= 1) return n;
  return fib(n - 2) + fib(n - 1);
}

let start = clock();
for (let i = 0; i < 20; i = i + 1) {
  print fib(i);
}
print "Time taken: " + (clock()-start);

fun makeCounter() {
  let i = 0;
  fun count() {
    i = i + 1;
    print i;
  }

  return count;
}

let counter = makeCounter();
counter(); // 1
counter(); // 2
